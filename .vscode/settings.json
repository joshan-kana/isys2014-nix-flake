{
  "nix.enableLanguageServer": true,
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "nixfmt"
        ]
      }
    }
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
    "editor.formatOnSave": false
  },
  "files.exclude": {
    "**/.devenv": true,
    "**/.direnv": true,
    "**/result": true,
    "**/result-*": true
  },
  "files.watcherExclude": {
    "**/.devenv/**": true,
    "**/.direnv/**": true
  },
  "search.exclude": {
    "**/.devenv": true,
    "**/.direnv": true
  }
}
