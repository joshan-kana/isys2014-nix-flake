{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Database: Open MySQL shell",
      "type": "shell",
      "command": "db",
      "problemMatcher": []
    },
    {
      "label": "Database: Run current SQL file",
      "type": "shell",
      "command": "db-run \"${file}\"",
      "problemMatcher": []
    },
    {
      "label": "SQL: Format current file",
      "type": "shell",
      "command": "sqlfmt \"${file}\"",
      "problemMatcher": []
    },
    {
      "label": "SQL: Lint current file",
      "type": "shell",
      "command": "sqllint \"${file}\"",
      "problemMatcher": []
    },
    {
      "label": "Format: all",
      "type": "shell",
      "command": "nix fmt",
      "problemMatcher": []
    },
    {
      "label": "Lint: all",
      "type": "shell",
      "command": "nix run .#lint",
      "problemMatcher": []
    },
    {
      "label": "Check: everything",
      "type": "shell",
      "command": "nix flake check",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
