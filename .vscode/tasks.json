{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Database: Open MySQL shell",
      "type": "shell",
      "command": "db",
      "problemMatcher": []
    },
    {
      "label": "Database: Run current SQL file",
      "type": "shell",
      "command": "db-run \"${file}\"",
      "problemMatcher": []
    },
    {
      "label": "Format: all",
      "type": "shell",
      "command": "nix fmt",
      "problemMatcher": []
    },
    {
      "label": "Check: everything",
      "type": "shell",
      "command": "nix flake check --impure",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
